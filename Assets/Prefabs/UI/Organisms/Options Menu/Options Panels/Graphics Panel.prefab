  m_Script: {fileID: 11500000, guid: 9435c99f06cb3bf4db750dccf34643a2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  toolTipText: 'The amount of chunks of terrain on top of the one the player is at
    to load around the player. Fog will be scaled accordingly. CAUTION: this setting
    is incredibly taxing on the CPU as it increases the chunks by the square of odd
    numbers, generating 9, 25, 49 or 121 tiles! This can have an enormous impact
    on load times!'
